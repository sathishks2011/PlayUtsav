generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         String      @default("HOST")
  displayName  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  hostProfile  HostProfile?
  sessions     Session[]
  tokens       UserSession[]
}

model HostProfile {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  organization  String?
  contactEmail  String?
  contactPhone  String?
  timezone      String?   @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserSession {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  refreshToken String  @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Session {
  id           String          @id @default(cuid())
  code         String          @unique
  status       String          @default("LOBBY")
  hostName     String?
  host         User?           @relation(fields: [hostId], references: [id], onDelete: SetNull)
  hostId       String?
  maxPlayers   Int             @default(4)
  language     String          @default("en")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  teams        Team[]
  participants Participant[]
  scores       Score[]
  quizRounds   QuizRound[]
}

model Team {
  id          String        @id @default(cuid())
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  name        String
  color       String?
  createdAt   DateTime      @default(now())
  participants Participant[]
  scores       Score[]
}

model Participant {
  id         String   @id @default(cuid())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId     String?
  displayName String
  role       String          @default("PLAYER")
  joinedAt   DateTime @default(now())
  quizAnswers QuizAnswer[]
}

model Score {
  id         String   @id @default(cuid())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId     String?
  value      Int      @default(0)
  delta      Int      @default(0)
  reason     String?
  recordedBy String?
  recordedAt DateTime @default(now())
}

model QuizRound {
  id            String      @id @default(cuid())
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  questionId    String
  prompt        String
  status        String      @default("running")
  correctOption Int?
  duration      Int         @default(30)
  createdAt     DateTime    @default(now())
  options       QuizOption[]
  answers       QuizAnswer[]
}

model QuizOption {
  id          String     @id @default(cuid())
  quizRound   QuizRound  @relation(fields: [quizRoundId], references: [id], onDelete: Cascade)
  quizRoundId String
  index       Int
  text        String

  @@unique([quizRoundId, index])
}

model QuizAnswer {
  id            String      @id @default(cuid())
  quizRound     QuizRound   @relation(fields: [quizRoundId], references: [id], onDelete: Cascade)
  quizRoundId   String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String
  answer        Int
  displayName   String
  createdAt     DateTime    @default(now())

  @@unique([quizRoundId, participantId])
}

model Template {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String
  locale    String   @default("en")
  createdAt DateTime @default(now())
}
