generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         String      @default("HOST")
  displayName  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  hostProfile  HostProfile?
  sessions     Session[]
  tokens       UserSession[]
}

model HostProfile {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  organization  String?
  contactEmail  String?
  contactPhone  String?
  timezone      String?   @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserSession {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  refreshToken String  @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Session {
  id                    String          @id @default(cuid())
  code                  String          @unique
  status                String          @default("LOBBY")
  hostName              String?
  host                  User?           @relation(fields: [hostId], references: [id], onDelete: SetNull)
  hostId                String?
  quizTemplate          QuizTemplate?   @relation(fields: [quizTemplateId], references: [id], onDelete: SetNull)
  quizTemplateId        String?
  currentCategoryIndex  Int             @default(0)
  currentQuestionIndex  Int             @default(0)
  maxPlayers            Int             @default(4)
  language              String          @default("en")
  playerEngagementType  String          @default("CHOICE_ANSWER")
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  teams                 Team[]
  participants          Participant[]
  scores                Score[]
  quizRounds            QuizRound[]
}

model Team {
  id          String        @id @default(cuid())
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  name        String
  color       String?
  createdAt   DateTime      @default(now())
  participants Participant[]
  scores       Score[]
}

model Participant {
  id         String   @id @default(cuid())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId     String?
  displayName String
  role       String          @default("PLAYER")
  joinedAt   DateTime @default(now())
  quizAnswers QuizAnswer[]
}

model Score {
  id         String   @id @default(cuid())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId     String?
  value      Int      @default(0)
  delta      Int      @default(0)
  reason     String?
  recordedBy String?
  recordedAt DateTime @default(now())
}

model QuizRound {
  id            String      @id @default(cuid())
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  questionId    String
  prompt        String
  status        String      @default("running")
  correctOption Int?
  duration      Int         @default(30)
  createdAt     DateTime    @default(now())
  options       QuizOption[]
  answers       QuizAnswer[]
}

model QuizOption {
  id          String     @id @default(cuid())
  quizRound   QuizRound  @relation(fields: [quizRoundId], references: [id], onDelete: Cascade)
  quizRoundId String
  index       Int
  text        String

  @@unique([quizRoundId, index])
}

model QuizAnswer {
  id            String      @id @default(cuid())
  quizRound     QuizRound   @relation(fields: [quizRoundId], references: [id], onDelete: Cascade)
  quizRoundId   String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String
  answer        Int
  displayName   String
  createdAt     DateTime    @default(now())

  @@unique([quizRoundId, participantId])
}

model Template {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String
  locale    String   @default("en")
  createdAt DateTime @default(now())
}

// Quiz Template and Question Bank Models

model QuizTemplate {
  id          String   @id @default(cuid())
  hostId      String
  name        String
  description String?
  categories  QuizCategory[]
  sessions    Session[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([hostId])
}

model QuizCategory {
  id          String   @id @default(cuid())
  template    QuizTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  name        String
  displayOrder Int
  questions   QuizQuestion[]
  createdAt   DateTime @default(now())
  
  @@index([templateId])
  @@index([templateId, displayOrder])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  category    QuizCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  question    String
  options     String   // JSON array of options
  correctAnswer Int
  displayOrder Int
  difficulty  String?  // EASY, MEDIUM, HARD
  points      Int      @default(100)
  timeLimit   Int      @default(30)
  explanation String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([categoryId])
  @@index([categoryId, displayOrder])
}

// Scoring System Models

model ScoringConfiguration {
  id          String   @id @default(cuid())
  hostId      String
  name        String
  description String?
  mode        String   // STANDARD, COMPETITIVE, EDUCATIONAL, CUSTOM
  config      String   // JSON field containing full ScoringConfig
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  sessions    SessionScoring[]
  
  @@index([hostId])
  @@index([hostId, isDefault])
}

model SessionScoring {
  id              String                 @id @default(cuid())
  sessionId       String                 @unique
  configId        String
  config          ScoringConfiguration   @relation(fields: [configId], references: [id], onDelete: Restrict)
  createdAt       DateTime               @default(now())
  
  history         ScoringHistory[]
  playerStats     PlayerScoringStats[]
  
  @@index([sessionId])
}

model ScoringHistory {
  id              String         @id @default(cuid())
  sessionScoringId String
  sessionScoring  SessionScoring @relation(fields: [sessionScoringId], references: [id], onDelete: Cascade)
  questionId      String
  playerId        String
  
  isCorrect       Boolean
  answerTime      Int            // Milliseconds
  pointsAwarded   Int
  breakdown       String         // JSON field containing ScoringBreakdown[]
  
  createdAt       DateTime       @default(now())
  
  @@index([sessionScoringId])
  @@index([sessionScoringId, playerId])
  @@index([sessionScoringId, questionId])
}

model PlayerScoringStats {
  id                  String         @id @default(cuid())
  sessionScoringId    String
  sessionScoring      SessionScoring @relation(fields: [sessionScoringId], references: [id], onDelete: Cascade)
  playerId            String
  
  totalScore          Int            @default(0)
  currentStreak       Int            @default(0)
  maxStreak           Int            @default(0)
  
  totalAnswers        Int            @default(0)
  correctAnswers      Int            @default(0)
  incorrectAnswers    Int            @default(0)
  
  averageAnswerTime   Int            @default(0) // Milliseconds
  fastestAnswerTime   Int?           // Milliseconds
  
  lastAnswerCorrect   Boolean?
  lastAnswerTime      DateTime?
  
  updatedAt           DateTime       @updatedAt
  
  @@unique([sessionScoringId, playerId])
  @@index([sessionScoringId])
  @@index([playerId])
}

// Bioscope Game Models

model BioscopeTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  hostId          String
  configuration   String   // JSON field containing game config (timer, sounds, etc.)
  rounds          String   // JSON array of rounds with images
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  sessions        BioscopeSession[]
  
  @@index([hostId])
  @@index([hostId, isPublic])
}

model BioscopeSession {
  id              String            @id @default(cuid())
  sessionId       String            @unique
  template        BioscopeTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateId      String
  currentRoundId  Int               @default(0)
  currentImageId  Int               @default(0)
  status          String            @default("idle") // idle, revealing, answering, revealed, completed
  revealedImages  String            @default("[]") // JSON array of revealed image IDs
  timerStartedAt  DateTime?
  timerDuration   Int               @default(30) // seconds
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  answers         BioscopeAnswer[]
  
  @@index([sessionId])
  @@index([templateId])
}

model BioscopeAnswer {
  id              String          @id @default(cuid())
  bioscope        BioscopeSession @relation(fields: [bioscopeId], references: [id], onDelete: Cascade)
  bioscopeId      String
  participantId   String
  participantName String
  roundId         Int
  answer          String
  submittedAt     DateTime        @default(now())
  imageRevealedAt Int             // Which image was showing when submitted (1, 2, 3, etc.)
  isCorrect       Boolean         @default(false)
  pointsAwarded   Int             @default(0)
  isManualScore   Boolean         @default(false) // True if host manually awarded points
  
  @@unique([bioscopeId, participantId, roundId])
  @@index([bioscopeId])
  @@index([bioscopeId, roundId])
}
