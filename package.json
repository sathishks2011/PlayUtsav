{
  "name": "family-fun-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @app/web dev",
    "dev:tv": "pnpm --filter @app/tv dev",
    "dev:api": "pnpm --filter @svc/api start:dev"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@noriginmedia/norigin-spatial-navigation": "^2.3.0"
  }
}
